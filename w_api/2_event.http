###
# @name createEvent
POST {{base_url}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
      "name": "conferencia2024",
      "date": "2024-09-21",
      "location": "ipb central de passos",
      "eventType": "general",
      "maxClientMale": "0" ,
      "maxClientFemale": "0",
      "maxStaffMale": "0",
      "maxStaffFemale": "0",
      "maxGeneralSpots": "200",
      "startDate": "2024-08-19T00:00:00Z",
      "endDate": "2024-09-21T23:59:59Z",
      "price": 5000
}

###
# @name listEvents
GET {{base_url}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

###
# @name getEvent
GET {{base_url}}/events/{{eventId}}
Content-Type: application/json
Authorization: Bearer {{token}}

###
# @name updateEvent
PUT {{base_url}}/events/{{eventId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "federa1"
}

###
# @name deleteEvent
DELETE {{base_url}}/events/{{eventId}}
Content-Type: application/json
Authorization: Bearer {{token}}


###
# @name excel
GET {{base_url}}/events/{{eventId}}/excel
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
Authorization: Bearer {{token}}