Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [
    {
      "amount": 36500,
      "description": "{{eventId}}"
    }
  ],
  "customer": {
    "email": "ariela.stefanini@sou.unifal-mg.edu.br"
  },
  "payments": {
    "payment_method": "credit_card",
