###
# FLUXO CORRETO DE COMPRA
###

# 1. Verificar se há vagas disponíveis
# @name checkSpot
GET {{base_url}}/events/{{eventId}}/check-spot
Content-Type: application/json
Authorization: Bearer {{token}}

###
# 2. Fazer a reserva (se houver vagas)
# @name makeReservation
POST {{base_url}}/events/{{eventId}}/reserve-spot
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "ticket_kind": "full",
  "userType": "client"
}

###
# 3. Verificar reservas do usuário
# @name getReservations
GET {{base_url}}/users/reservations
Content-Type: application/json
Authorization: Bearer {{token}}

###
# 4. Obter ticket (agora deve funcionar)
# @name getTicket
GET {{base_url}}/tickets/{{eventId}}/purchase
Content-Type: application/json
Authorization: Bearer {{token}}

###
# 5. Se tiver ticket válido, proceder com o pagamento PIX
# @name pagarmePixPayment
POST {{base_url}}/payments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [
    {
      "amount": 36500,
      "description": "{{eventId}}"
    }
  ],
  "customer": {
    "email": "ariela.stefanini@sou.unifal-mg.edu.br"
  },
  "payments": {
    "payment_method": "pix"
  }
}

###
# 6. Alternativa: Pagamento com boleto
# @name pagarmeBoleto
POST {{base_url}}/payments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [
    {
      "amount": 36500,
      "description": "{{eventId}}"
    }
  ],
  "customer": {
    "email": "ariela.stefanini@sou.unifal-mg.edu.br"
  },
  "payments": {
    "payment_method": "boleto",
    "boleto": {
      "due_at": "2025-05-05T00:00:00Z"
    }
  }
}

###
# 7. Alternativa: Pagamento com cartão de crédito
# @name pagarmeCredit
POST {{base_url}}/payments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [
    {
      "amount": 36500,
      "description": "{{eventId}}"
    }
  ],
  "customer": {
    "email": "ariela.stefanini@sou.unifal-mg.edu.br"
  },
  "payments": {
    "payment_method": "credit_card",
    "credit_card": {
      "card": {
        "number": "4000000000000010",
        "holder_name": "Teste da Silva",
        "exp_month": 12,
        "exp_year": 2030,
        "cvv": "123"
      },
      "installments": 1
    }
  }
}

###
# TESTES DE DIAGNÓSTICO
###

# Verificar status da reserva após o pagamento
# @name checkReservationAfterPayment
GET {{base_url}}/tickets/{{eventId}}/retry
Content-Type: application/json
Authorization: Bearer {{token}}

###
# Verificar todas as reservas novamente
# @name getReservationsAfterPayment
GET {{base_url}}/users/reservations
Content-Type: application/json
Authorization: Bearer {{token}}